APP_NAME="BudgetControl Sync"
APP_ENV=local
LOG_CHANNEL=stderr
APP_LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer
# Must match the Gateway API_SECRET; restrict service network access too.
SECRET_KEY=
# Enable Banking application ID, private RSA key file and registered callback.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=
# A random 32-byte key, encoded as base64. Keep stable across deployments.
SYNC_ENCRYPTION_KEY=
ENTRY_API_BASE_URL=
# Must match Entries SYNC_API_SECRET.
ENTRY_SYNC_SECRET=
